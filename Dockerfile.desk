# The Care Desk: a small web app talking to Firestore and Claude. None of the
# auditors' Chromium or ffmpeg, so the image is a fraction of the size and
# starts fast.

# The new desk's React pages (care_desk/web) are built in a Node stage of their
# own, so the running image carries only the finished files, not Node.
FROM node:22-slim AS web
WORKDIR /web
COPY care_desk/web/package.json care_desk/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY care_desk/web/ ./
RUN npm run build

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-desk.txt ./
RUN pip install --no-cache-dir -r requirements-desk.txt

# Sign-in is the Redefine App's own: its team list, sessions and Firestore client.
COPY service/__init__.py service/auth.py service/team.py service/firestore_db.py service/email_login.py service/profiles.py ./service/
COPY care_desk/ ./care_desk/
COPY --from=web /web/dist/ ./care_desk/web/dist/

RUN useradd --create-home desk
USER desk

# Cloud Run sends traffic to $PORT and will not route to anything else.
ENV PORT=8080
EXPOSE 8080

CMD exec uvicorn care_desk.app:app --host 0.0.0.0 --port ${PORT} --workers 1 --timeout-keep-alive 75 --proxy-headers --forwarded-allow-ips="*"
