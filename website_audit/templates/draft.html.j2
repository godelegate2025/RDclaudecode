<!doctype html>
<!--
  Home page draft for {{ name }}, generated from a website audit of {{ url }}.

  What this draft did with the audit:
{% for line in resolved %}  - {{ line }}
{% endfor %}
  Not addressed by a page draft (needs content, hosting or ops work):
{% for line in unresolved %}  - {{ line }}
{% endfor %}
  Anything marked [PLACEHOLDER] was not available to the audit and was not invented.
-->
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ name }} — {{ h1 }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ name }} — {{ h1 }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ url }}">
<meta property="og:site_name" content="{{ name }}">
<meta property="og:image" content="{{ base }}og-image.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="{{ tokens.brand }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='{{ tokens.brand | replace('#', '%23') }}'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-family='Georgia,serif' font-size='18' fill='{{ tokens.on_brand | replace('#', '%23') }}'%3E{{ name[0] | upper }}%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ google_fonts }}">
<script type="application/ld+json">
{{ schema_json | safe }}
</script>
<style>
/* Direction: warm editorial — the site's own brand colour and typefaces, a
   paper ground, generous measure, one action colour carrying every button.
   Every colour and size is a token so the whole page retunes from :root. */
:root {
  --surface: {{ tokens.surface }};
  --surface-2: {{ tokens.surface_2 }};
  --ink: {{ tokens.ink }};
  --muted: {{ tokens.muted }};
  --brand: {{ tokens.brand }};
  --on-brand: {{ tokens.on_brand }};
  --line: {{ tokens.line }};

  --font-display: '{{ display_font }}', Georgia, 'Times New Roman', serif;
  --font-body: '{{ body_font }}', system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;

  --text-sm: 0.875rem;                       /* 14px  fine print          */
  --text-base: 1.0625rem;                    /* 17px  body                */
  --text-lg: 1.25rem;                        /* 20px  lede, nav           */
  --text-xl: clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem);   /* section heading */
  --text-2xl: clamp(2rem, 1.4rem + 2.4vw, 2.75rem);     /* page heading    */
  --text-hero: clamp(2.5rem, 1.6rem + 4vw, 4.25rem);    /* hero            */

  --leading-tight: 1.1;
  --leading-body: 1.55;
  --measure: 64ch;

  --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem;
  --space-6: 1.5rem; --space-8: 2rem; --space-12: 3rem; --space-16: 4rem; --space-24: 6rem;

  --radius: 6px;
  --tap: 44px;
  --gutter: clamp(1rem, 4vw, 2.5rem);
  --content: 1120px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --surface: {{ tokens.ink }};
    --surface-2: {{ tokens.surface_2 }}22;
    --ink: {{ tokens.surface }};
    --muted: {{ tokens.surface }};
    --brand: {{ tokens.brand_on_dark }};
    --on-brand: {{ tokens.ink }};
    --line: {{ tokens.surface }}33;
  }
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--surface);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-body);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img, svg { max-width: 100%; height: auto; display: block; }
h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: var(--leading-tight); margin: 0; letter-spacing: -0.01em; }
h1 { font-size: var(--text-hero); }
h2 { font-size: var(--text-2xl); }
h3 { font-size: var(--text-xl); }
p { margin: 0; max-width: var(--measure); }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; border-radius: 2px; }
.skip-link { position: absolute; left: -9999px; top: 0; z-index: 100; background: var(--ink); color: var(--surface); padding: var(--space-3) var(--space-4); }
.skip-link:focus { left: 0; }

.wrap { width: min(100% - 2 * var(--gutter), var(--content)); margin-inline: auto; }
.eyebrow { font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand); margin-bottom: var(--space-3); }
.muted { color: var(--muted); }

/* ---------- buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
  min-height: var(--tap); padding: 0 var(--space-6);
  background: var(--brand); color: var(--on-brand);
  font-weight: 600; font-size: var(--text-base); text-decoration: none;
  border: 2px solid var(--brand); border-radius: var(--radius); cursor: pointer;
  transition: transform .15s ease, box-shadow .15s ease;
}
.btn:hover { box-shadow: 0 6px 18px -8px var(--ink); transform: translateY(-1px); }
.btn:active { transform: scale(0.97); }
.btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }
.btn.ghost:hover { border-color: var(--ink); }

/* ---------- header ---------- */
.site-header { position: sticky; top: 0; z-index: 20; background: var(--surface); border-bottom: 1px solid var(--line); }
.site-header .wrap { display: flex; align-items: center; gap: var(--space-4); min-height: 72px; }
.brand { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); text-decoration: none; display: inline-flex; align-items: center; min-height: var(--tap); }
.brand .mark { width: 32px; height: 32px; border-radius: var(--radius); background: var(--brand); color: var(--on-brand); display: inline-grid; place-items: center; margin-right: var(--space-3); font-size: var(--text-lg); }
.menu-toggle { margin-left: auto; min-width: var(--tap); min-height: var(--tap); background: none; border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink); font: inherit; cursor: pointer; }
.site-nav { display: none; width: 100%; }
.site-nav[data-open] { display: block; }
.site-nav ul { list-style: none; margin: 0; padding: 0 0 var(--space-4); display: flex; flex-direction: column; }
.site-nav a { display: flex; align-items: center; min-height: var(--tap); padding: 0 var(--space-2); text-decoration: none; font-weight: 500; border-radius: var(--radius); }
.site-nav a:hover { background: var(--surface-2); }
.site-nav .cta { margin-top: var(--space-2); }
@media (min-width: 900px) {
  .menu-toggle { display: none; }
  .site-nav { display: block; width: auto; margin-left: auto; }
  .site-nav ul { flex-direction: row; align-items: center; gap: var(--space-2); padding: 0; }
  .site-nav .cta { margin: 0 0 0 var(--space-4); }
}

/* ---------- placeholders ---------- */
.ph {
  position: relative; display: grid; place-items: center; text-align: center;
  background: var(--surface-2); border: 2px dashed var(--line); border-radius: var(--radius);
  color: var(--muted); font-size: var(--text-base); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  padding: var(--space-4); overflow: hidden;
}
.ph::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, transparent 0 14px, var(--line) 14px 15px); opacity: .5; }
.ph span { position: relative; background: var(--surface); padding: var(--space-2) var(--space-3); border-radius: var(--radius); }
.ph.hero { aspect-ratio: 4 / 5; }
.ph.wide { aspect-ratio: 3 / 2; }
.ph-text { border-bottom: 2px dashed var(--line); color: var(--muted); }

/* ---------- hero ---------- */
.hero { padding: var(--space-16) 0 var(--space-12); border-bottom: 1px solid var(--line); }
.hero .wrap { display: grid; gap: var(--space-8); align-items: center; }
.hero .lede { font-size: var(--text-lg); margin: var(--space-6) 0 var(--space-8); color: var(--muted); }
.hero .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.hero > .wrap > * { opacity: 0; transform: translateY(16px); animation: rise .6s ease forwards; }
.hero > .wrap > :nth-child(2) { animation-delay: .15s; }
@keyframes rise { to { opacity: 1; transform: none; } }
@media (min-width: 900px) {
  .hero { padding: var(--space-24) 0 var(--space-16); }
  .hero .wrap { grid-template-columns: 7fr 5fr; gap: var(--space-16); }
}

/* ---------- sections ---------- */
.section { padding: var(--space-16) 0; border-bottom: 1px solid var(--line); }
.section .wrap { display: grid; gap: var(--space-8); align-items: center; }
.section .copy { margin-top: var(--space-4); }
.section .more { display: inline-flex; align-items: center; min-height: var(--tap); margin-top: var(--space-4); font-weight: 600; color: var(--brand); text-decoration: none; }
.section .more:hover { text-decoration: underline; }
.section:nth-of-type(even) { background: var(--surface-2); }
@media (min-width: 900px) {
  .section .wrap { grid-template-columns: 1fr 1fr; gap: var(--space-16); }
  .section:nth-of-type(even) .text { order: 2; }
}

/* ---------- faq ---------- */
.faq details { border-top: 1px solid var(--line); }
.faq details:last-child { border-bottom: 1px solid var(--line); }
.faq summary { display: flex; align-items: center; justify-content: space-between; min-height: var(--tap); padding: var(--space-3) 0; cursor: pointer; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; list-style: none; }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; color: var(--brand); font-size: var(--text-xl); }
.faq details[open] summary::after { content: "–"; }
.faq .answer { padding: 0 0 var(--space-6); }

/* ---------- closing band ---------- */
.band { background: var(--ink); color: var(--surface); padding: var(--space-16) 0; }
.band .wrap { display: grid; gap: var(--space-8); }
.band h2 { color: var(--surface); }
.band p { color: var(--surface); }
.band .btn { background: var(--surface); color: var(--ink); border-color: var(--surface); }
.band dl { margin: 0; display: grid; gap: var(--space-4); }
.band dt { font-size: var(--text-sm); letter-spacing: 0.12em; text-transform: uppercase; opacity: .85; }
.band dd { margin: var(--space-1) 0 0; font-size: var(--text-lg); }
@media (min-width: 900px) { .band .wrap { grid-template-columns: 3fr 2fr; } }

/* ---------- footer ---------- */
.site-footer { padding: var(--space-12) 0; }
.site-footer .wrap { display: grid; gap: var(--space-8); }
.site-footer h3 { font-family: var(--font-body); font-size: var(--text-sm); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: var(--space-3); }
.site-footer ul { list-style: none; margin: 0; padding: 0; }
.site-footer li a { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; }
.site-footer li a:hover { text-decoration: underline; }
.site-footer .legal { color: var(--muted); font-size: var(--text-sm); border-top: 1px solid var(--line); padding-top: var(--space-6); }
@media (min-width: 900px) { .site-footer .wrap { grid-template-columns: 2fr 1fr 1fr; } .site-footer .legal { grid-column: 1 / -1; } }

/* ---------- draft notes ---------- */
.notes { background: var(--surface-2); border-top: 2px dashed var(--line); padding: var(--space-8) 0; }
.notes summary { cursor: pointer; font-weight: 600; min-height: var(--tap); display: flex; align-items: center; }
.notes ul { padding-left: 1.2em; }
.notes li { margin: var(--space-2) 0; max-width: var(--measure); }
.notes code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: inherit; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  html { scroll-behavior: auto; }
}
</style>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ base }}"><span class="mark" aria-hidden="true">{{ name[0] | upper }}</span>{{ name }}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {% for link in nav %}<li><a href="{{ link.href }}">{{ link.text }}</a></li>
        {% endfor %}<li class="cta"><a class="btn" href="{{ cta.href }}">{{ cta.text }}</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div>
        {% if h1 != name %}<p class="eyebrow">{{ name }}</p>{% endif %}
        <h1 id="hero-title">{{ h1 }}</h1>
        <p class="lede">{{ lede }}</p>
        <div class="actions">
          <a class="btn" href="{{ cta.href }}">{{ cta.text }}</a>
          {% if nav %}<a class="btn ghost" href="{{ nav[0].href }}">{{ nav[0].text }}</a>{% endif %}
        </div>
      </div>
      <div class="ph hero" role="img" aria-label="Placeholder for the hero photograph"><span>[Placeholder] Hero photo</span></div>
    </div>
  </section>

  {% for section in sections %}
  <section class="section" aria-labelledby="s{{ loop.index }}">
    <div class="wrap">
      <div class="text">
        <h2 id="s{{ loop.index }}">{{ section.title }}</h2>
        {% if section.body %}<p class="copy">{{ section.body }}</p>
        {% else %}<p class="copy ph-text">[Placeholder] The current page has this heading but no copy beneath it. Two sentences go here.</p>{% endif %}
        <a class="more" href="{{ cta.href }}">{{ cta.text }} →</a>
      </div>
      <div class="ph wide" role="img" aria-label="Placeholder image for {{ section.title }}"><span>[Placeholder] {{ section.title }} photo</span></div>
    </div>
  </section>
  {% endfor %}

  {% if faq %}
  <section class="section faq" aria-labelledby="faq-title">
    <div class="wrap" style="display:block">
      <p class="eyebrow">Questions</p>
      <h2 id="faq-title">Answers before you ask</h2>
      <div style="margin-top: var(--space-8)">
        {% for q in faq %}
        <details>
          <summary><h3>{{ q }}</h3></summary>
          <p class="answer ph-text">[Placeholder] Answer this in two or three sentences.</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="band" id="contact" aria-labelledby="band-title">
    <div class="wrap">
      <div>
        <h2 id="band-title">{{ h1 }}</h2>
        <p style="margin: var(--space-4) 0 var(--space-8)">{{ lede }}</p>
        <a class="btn" href="{{ cta.href }}">{{ cta.text }}</a>
      </div>
      <dl>
        <div><dt>Phone</dt><dd>[Placeholder] Phone number</dd></div>
        <div><dt>Address</dt><dd>[Placeholder] Street, town, postcode</dd></div>
        <div><dt>Hours</dt><dd>[Placeholder] Opening hours</dd></div>
      </dl>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap">
    <div>
      <a class="brand" href="{{ base }}"><span class="mark" aria-hidden="true">{{ name[0] | upper }}</span>{{ name }}</a>
      <p class="muted" style="margin-top: var(--space-3)">{{ description }}</p>
    </div>
    <div>
      <h3>Pages</h3>
      <ul>{% for link in nav %}<li><a href="{{ link.href }}">{{ link.text }}</a></li>{% endfor %}</ul>
    </div>
    <div>
      <h3>More</h3>
      <ul>
        {% for link in footer %}<li><a href="{{ link.href }}">{{ link.text }}{% if link.placeholder %} <span class="muted">[placeholder]</span>{% endif %}</a></li>{% endfor %}
        {% for href in social %}<li><a href="{{ href }}" rel="noopener">{{ href | replace('https://', '') | replace('http://', '') | replace('www.', '') | truncate(32) }}</a></li>{% endfor %}
      </ul>
    </div>
    <p class="legal">© {{ name }}. Draft generated from a website audit; every [Placeholder] needs real content before launch.</p>
  </div>
</footer>

<details class="notes">
  <summary class="wrap">About this draft — what the audit changed</summary>
  <div class="wrap">
    <ul>{% for line in notes %}<li>{{ line }}</li>{% endfor %}</ul>
    <p><strong>Findings resolved by construction</strong></p>
    <ul>{% for line in resolved %}<li><code>{{ line.split(':')[0] }}</code>{{ line[line.find(':') + 1:] }}</li>{% endfor %}</ul>
    {% if unresolved %}
    <p><strong>Still open (a page draft cannot fix these)</strong></p>
    <ul>{% for fid in unresolved %}<li><code>{{ fid }}</code></li>{% endfor %}</ul>
    {% endif %}
  </div>
</details>

<script>
  // The only script on the page: the mobile menu. Everything else is HTML.
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle.addEventListener('click', () => {
    const open = nav.hasAttribute('data-open');
    if (open) nav.removeAttribute('data-open'); else nav.setAttribute('data-open', '');
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
</body>
</html>
